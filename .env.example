# --- storage ---
DATA_DIR=/Volumes/T7/raingist
# --- Raindrop app (one for the whole service) ---
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
RAINDROP_REDIRECT_URI=http://localhost:8765/callback
ACCOUNT_STORE=files
# --- LLM (ordered fallback; each listed provider needs <NAME>_API_KEY) ---
LLM_PROVIDERS=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
SUMMARY_LANGUAGE=en
# --- content ---
ENABLED_EXTRACTORS=tiktok
# Netscape cookies.txt, e.g. /Users/<you>/raingist/secrets/tiktok-cookies.txt (optional)
TIKTOK_COOKIES_FILE=
TRANSCRIBER=mlx-whisper
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
OCR_BACKEND=vision
# --- behaviour ---
POLL_INTERVAL_SECONDS=60
MAX_ITEMS_PER_ACCOUNT=10
RETRY_BACKOFF_MINUTES=2,10,30,120,360
TAG_FAILED=raingist-failed
TAG_SKIP=raingist-skip
TAG_OCR=raingist-ocr
TAG_REDO=raingist-redo
# --- organizing Unsorted (ADR 0008); 0 turns the daily run off ---
ORGANIZE_ENABLED=1
ORGANIZE_FIRST_RUN=30
ORGANIZE_MIN_GROUP=5
ORGANIZE_MAX_ITEMS=200
# --- alerts (ntfy URL) ---
NOTIFY_URL=
